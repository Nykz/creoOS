# Public InsForge configuration used by the browser and server routes.
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-insforge-anon-key

# Server-only admin credentials are not required by the app at runtime.
# Never commit INSFORGE_API_KEY. If you add it for local tooling, keep it in .env.local.
# INSFORGE_URL=https://your-project.region.insforge.app
# INSFORGE_API_KEY=your-server-only-api-key
